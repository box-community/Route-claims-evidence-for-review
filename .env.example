# Copy this file to .env and fill in your real values.
# Find credentials in the Box Developer Console:
# https://cloud.app.box.com/developers/console

# CCG app credentials (Configuration tab)
BOX_CLIENT_ID=your_client_id
BOX_CLIENT_SECRET=your_client_secret

# Managed user who can start Automate workflows (digits only).
# Do not use the enterprise service account here.
BOX_USER_ID=your_managed_user_id

# Claims Review folder that the Manual Start trigger is scoped to
BOX_CLAIMS_FOLDER_ID=your_claims_review_folder_id

# Enterprise metadata template key (Admin Console > Metadata)
BOX_CLAIMS_TEMPLATE_KEY=your_metadata_template_key

# Must match the published Automate workflow name exactly
BOX_CLAIMS_WORKFLOW_NAME=Claims evidence review
